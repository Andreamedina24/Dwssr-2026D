<div class="max-w-md p-8 mt-10 ml-10 bg-gray-900 border border-gray-800 rounded-2xl shadow-2xl font-sans">
    <h1 class="text-5xl font-serif text-purple-400 tracking-wide mb-3">
        {{title}}
    </h1>
    <p class="text-gray-300 text-xl font-light mb-8">
        Welcome to <span class="font-semibold text-white">{{title}}</span>
    </p>
    <div class="inline-block bg-purple-600 text-white font-mono px-5 py-2 rounded-full mb-8 shadow-lg">
        Counter: {{counter}}
    </div>
    <div class="bg-gray-800 rounded-xl p-5 border border-gray-700 shadow-inner">
        {{#each numbers}}
            <p class="text-purple-200 font-medium py-2 border-b border-gray-700 last:border-0 hover:text-white transition-colors cursor-default">
                Te mando un 🎉🎉🎉
            </p>
        {{/each}}
    </div>

</div>