<div class="max-w-md p-6 mt-10 ml-10 bg-blue-50 border-2 border-blue-200 rounded-xl shadow-md">
    <h1 class="text-4xl font-bold text-blue-700 mb-2">
        {{title}}
    </h1>
    <p class="text-gray-700 text-lg mb-6">
        Welcome to {{title}}
    </p>
    <p class="text-green-800 bg-green-200 font-semibold px-4 py-2 rounded-lg mb-6 w-fit shadow-sm">
        Counter: {{counter}}
    </p>
    <div class="bg-orange-100 border border-orange-300 rounded-lg p-4 shadow-sm mb-6">
        {{#each numbers}}
            <p class="text-orange-800 font-medium py-1">Te mando un 🐱 (Elemento: {{this}})</p>
        {{/each}}
    </div>
    <button class="bg-teal-500 hover:bg-teal-600 text-white font-semibold px-4 py-2 rounded-lg transition-colors shadow">
        Click me
    </button>
</div>